  (text "Li-Po Charger" (at 81.915 41.275 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid 02da6e55-c6df-40d6-86c9-b49e06d314bb)
  )
  (text "zephyr gpio settings of:\n\nGPIO_INPUT | GPIO_PULL_UP | GPIO_ACTIVE_LOW\n\nfeel less consistent than\n\nGPIO_INPUT | GPIO_ACTIVE_LOW and with a 10k pull-up"
    (at 116.84 200.025 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid 157b2178-dbef-4b5b-a88d-68f89bf4dba4)
  )
